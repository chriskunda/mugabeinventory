# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/dashboard_db?retryWrites=true&w=majority

# Any long random string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=5000
NODE_ENV=development

# Your frontend's URL, so cookies/CORS work correctly
CLIENT_URL=http://localhost:5173
